{
  "name": "@falcondev-oss/form-core",
  "type": "module",
  "version": "0.24.1",
  "description": "Type-safe, framework agnostic form state library based on @vue/reactivity.",
  "license": "Apache-2.0",
  "repository": "github:falcondev-oss/form",
  "bugs": {
    "url": "https://github.com/falcondev-oss/form/issues"
  },
  "keywords": [
    "form",
    "frontend",
    "state-management",
    "reactivity",
    "typescript"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./reactive": "./src/reactive.ts"
  },
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json",
      "./reactive": {
        "import": {
          "types": "./dist/reactive.d.ts",
          "default": "./dist/reactive.js"
        },
        "require": {
          "types": "./dist/reactive.d.cts",
          "default": "./dist/reactive.cjs"
        }
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "24",
    "pnpm": "11"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsdown src/index.ts src/reactive.ts",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@vue/reactivity": ">=3.5.28 <4"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@vueuse/core": "^14.4.0",
    "dot-prop": "^10.2.0",
    "hookable": "^6.1.1",
    "json-schema-typed": "^8.0.2",
    "klona": "^2.0.6",
    "on-change": "^6.0.2",
    "remeda": "^2.39.0",
    "ts-pattern": "^5.9.0",
    "type-fest": "^5.8.0"
  },
  "devDependencies": {
    "@ark/schema": "^0.56.2",
    "arktype": "^2.2.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
